# Backend
PORT=8080
# Set DEV_MODE=true to force in-memory store + local auth (default when FIREBASE_CREDENTIALS is empty)
DEV_MODE=true
# FIREBASE_CREDENTIALS=./firebase-service-account.json
# FIREBASE_PROJECT_ID=your-project-id
# Essay grading by context (Google Gemini). Without a key, essays use text similarity.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODEL=gemini-3.8-flash   (use "none" to disable)
