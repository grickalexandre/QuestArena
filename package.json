{
  "name": "questarena",
  "private": true,
  "scripts": {
    "dev": "concurrently -n back,front -c teal,orange \"npm run dev:back\" \"npm run dev:front\"",
    "dev:back": "cd backend && go run ./cmd/server",
    "dev:front": "cd frontend && npm run dev",
    "build": "npm run build:back && npm run build:front",
    "build:back": "cd backend && go build -o bin/server.exe ./cmd/server",
    "build:front": "cd frontend && npm run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
